# Supabase (auth + sync)
# Create a project at https://supabase.com — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Unsplash API (needed for "Other" subcategory photo search by activity title)
# Create an app at https://unsplash.com/developers and paste the Access Key:
EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=

# Google Cloud Vision SafeSearch (screens user photo evidence before attach)
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable "Cloud Vision API"
# 3. Create an API key (restrict to Vision API)
# 4. Paste below, then restart Metro
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=
